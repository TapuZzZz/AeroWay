@model AeroWayClient.Models.LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Account/login.css" asp-append-version="true" />
}

<section class="login-container">
    <div class="animated-elements">
        <div class="floating-shape shape-1"></div>
        <div class="floating-shape shape-2"></div>
        <div class="floating-shape shape-3"></div>
    </div>
    
    <div class="login-box">
        <div class="login-header">
            <h2>Welcome Back</h2>
            <p>Login to your AeroWay account</p>
        </div>
        
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                <div class="alert-icon">
                    <i class="fas fa-exclamation-circle"></i>
                </div>
                <div class="alert-content">
                    @Html.ValidationSummary(false, "", new { @class = "alert-list" })
                </div>
            </div>
        }
        
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">
                <div class="alert-icon">
                    <i class="fas fa-check-circle"></i>
                </div>
                <div class="alert-content">
                    @TempData["SuccessMessage"]
                </div>
            </div>
        }
        
        <form asp-action="Login" method="post" id="loginForm">
            <div class="form-group">
                <label asp-for="Email" class="form-label">Email Address</label>
                <div class="input-with-icon">
                    <i class="fas fa-envelope"></i>
                    <input asp-for="Email" class="form-control" placeholder="Enter your email" />
                </div>
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            
            <div class="form-group">
                <label asp-for="Password" class="form-label">Password</label>
                <div class="password-wrapper">
                    <div class="input-with-icon">
                        <i class="fas fa-lock"></i>
                        <input asp-for="Password" class="form-control" placeholder="Enter your password" />
                        <button type="button" class="password-toggle" id="passwordToggle" aria-label="Toggle password visibility">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                </div>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            
            <button type="submit" class="btn-login">
                <i class="fas fa-sign-in-alt"></i>
                <span>Login</span>
            </button>
        </form>
        
        <div class="login-divider">
            <span>or</span>
        </div>
        
        <div class="social-login">
            <button type="button" class="btn-social btn-google">
                <i class="fab fa-google"></i>
                <span>Continue with Google</span>
            </button>
            <button type="button" class="btn-social btn-facebook">
                <i class="fab fa-facebook-f"></i>
                <span>Continue with Facebook</span>
            </button>
        </div>
        
        <div class="form-footer">
            <p>Don't have an account? <a asp-action="Register" asp-controller="Account">Create Account</a></p>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/Account/login.js" asp-append-version="true"></script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}