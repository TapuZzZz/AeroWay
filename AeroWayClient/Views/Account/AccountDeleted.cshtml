@{
    ViewData["Title"] = "Account Deleted - AeroWay";
    Layout = "_Layout";
}

@section Styles {
<link rel="stylesheet" href="~/css/Account/AccountDeleted.css" />
}

<div class="account-deleted-wrapper">
    <div class="account-deleted-container">
        <div class="delete-icon">
            <i class="fas fa-check-circle"></i>
        </div>
        
        <h1 class="delete-title">Account Deleted</h1>
        <p class="delete-subtitle">Successfully Removed</p>
        
        <p class="delete-message">
            @ViewBag.DeleteMessage
        </p>
        
        <div class="delete-info">
            <h4>
                <i class="fas fa-info-circle"></i>
                What was removed:
            </h4>
            <ul>
                <li>
                    <i class="fas fa-user"></i>
                    Personal profile and account information
                </li>
                <li>
                    <i class="fas fa-history"></i>
                    All booking history and flight records
                </li>
                <li>
                    <i class="fas fa-award"></i>
                    Membership status and accumulated benefits
                </li>
                <li>
                    <i class="fas fa-cog"></i>
                    All preferences and activity data
                </li>
                <li>
                    <i class="fas fa-envelope"></i>
                    Email verification records
                </li>
            </ul>
        </div>
        
        <div class="action-buttons">
            <a href="@Url.Action("Index", "Home")" class="btn-home">
                <i class="fas fa-home"></i>
                Return to Home
            </a>
            <a href="@Url.Action("Register", "Account")" class="btn-register">
                <i class="fas fa-user-plus"></i>
                Create New Account
            </a>
        </div>
        
        <div class="feedback-section">
            <p class="feedback-text">
                We'd love to hear your feedback about your experience with AeroWay. 
                If you have any comments or suggestions, please reach out to us at 
                <a href="mailto:feedback@aeroway.com" class="feedback-email">feedback@aeroway.com</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/js/Account/AccountDeleted.js"></script>
}