@model AeroWayClient.Models.BookingConfirmationViewModel
@{
    ViewData["Title"] = "Booking Confirmed";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Flight/print-invoice.css" />
    <link rel="stylesheet" href="~/css/Flight/booking-confirmation.css" />
}

<div class="confirmation-wrapper">
    <div class="animated-bg-shapes">
        <div class="shape shape-1"></div>
        <div class="shape shape-2"></div>
        <div class="shape shape-3"></div>
    </div>
    
    <div class="container">
        <div class="success-header">
            <div class="success-icon-wrapper">
                <i class="fas fa-check success-icon"></i>
            </div>
            <h1 class="success-title">BOOKING CONFIRMED!</h1>
            <p class="success-subtitle">🎉 Your exclusive private jet experience is ready! 🎉</p>
            
            <div class="booking-reference-box">
                <p class="reference-label">Booking Reference Number</p>
                <div class="reference-number">
                    @Model.BookingReference
                    <button class="copy-btn" onclick="copyReference('@Model.BookingReference')">
                        <i class="fas fa-copy"></i>
                        Copy
                    </button>
                </div>
            </div>
        </div>
        
        <div class="details-container">
            <div class="details-grid">
                <!-- Flight Information -->
                <div class="detail-card">
                    <div class="card-header">
                        <div class="card-icon">
                            <i class="fas fa-plane"></i>
                        </div>
                        <h2 class="card-title">Flight Details</h2>
                    </div>
                    
                    @if (Model.OutboundFlight != null)
                    {
                        <div class="flight-segment">
                            <div class="flight-header">
                                <span class="flight-type">Outbound Flight</span>
                                <span class="flight-number">@Model.OutboundFlight.FlightNumber</span>
                            </div>
                            
                            <div class="flight-route">
                                <div class="airport-info">
                                    <div class="airport-code">@Model.OutboundFlight.OriginCode</div>
                                    <div class="airport-city">@Model.OutboundFlight.OriginCity</div>
                                    <div class="flight-time">@Model.OutboundFlight.DepartureTime.ToString("HH:mm")</div>
                                    <div class="flight-date">@Model.OutboundFlight.DepartureTime.ToString("MMM dd, yyyy")</div>
                                </div>
                                
                                <div class="flight-arrow">
                                    <div class="arrow-line"></div>
                                    <span class="flight-duration">@Model.OutboundFlight.Duration</span>
                                </div>
                                
                                <div class="airport-info">
                                    <div class="airport-code">@Model.OutboundFlight.DestinationCode</div>
                                    <div class="airport-city">@Model.OutboundFlight.DestinationCity</div>
                                    <div class="flight-time">@Model.OutboundFlight.ArrivalTime.ToString("HH:mm")</div>
                                    <div class="flight-date">@Model.OutboundFlight.ArrivalTime.ToString("MMM dd, yyyy")</div>
                                </div>
                            </div>
                            
                            <div class="flight-details">
                                <div class="detail-item">
                                    <div class="detail-label">Aircraft</div>
                                    <div class="detail-value">@Model.OutboundFlight.AircraftModel</div>
                                </div>
                                <div class="detail-item">
                                    <div class="detail-label">Flight Time</div>
                                    <div class="detail-value">@Model.OutboundFlight.Duration</div>
                                </div>
                                <div class="detail-item">
                                    <div class="detail-label">Base Price</div>
                                    <div class="detail-value">$@Model.OutboundFlight.Price.ToString("N0")</div>
                                </div>
                            </div>
                        </div>
                    }
                    
                    @if (Model.ReturnFlight != null)
                    {
                        <div class="flight-segment">
                            <div class="flight-header">
                                <span class="flight-type">Return Flight</span>
                                <span class="flight-number">@Model.ReturnFlight.FlightNumber</span>
                            </div>
                            
                            <div class="flight-route">
                                <div class="airport-info">
                                    <div class="airport-code">@Model.ReturnFlight.OriginCode</div>
                                    <div class="airport-city">@Model.ReturnFlight.OriginCity</div>
                                    <div class="flight-time">@Model.ReturnFlight.DepartureTime.ToString("HH:mm")</div>
                                    <div class="flight-date">@Model.ReturnFlight.DepartureTime.ToString("MMM dd, yyyy")</div>
                                </div>
                                
                                <div class="flight-arrow">
                                    <div class="arrow-line"></div>
                                    <span class="flight-duration">@Model.ReturnFlight.Duration</span>
                                </div>
                                
                                <div class="airport-info">
                                    <div class="airport-code">@Model.ReturnFlight.DestinationCode</div>
                                    <div class="airport-city">@Model.ReturnFlight.DestinationCity</div>
                                    <div class="flight-time">@Model.ReturnFlight.ArrivalTime.ToString("HH:mm")</div>
                                    <div class="flight-date">@Model.ReturnFlight.ArrivalTime.ToString("MMM dd, yyyy")</div>
                                </div>
                            </div>
                            
                            <div class="flight-details">
                                <div class="detail-item">
                                    <div class="detail-label">Aircraft</div>
                                    <div class="detail-value">@Model.ReturnFlight.AircraftModel</div>
                                </div>
                                <div class="detail-item">
                                    <div class="detail-label">Flight Time</div>
                                    <div class="detail-value">@Model.ReturnFlight.Duration</div>
                                </div>
                                <div class="detail-item">
                                    <div class="detail-label">Base Price</div>
                                    <div class="detail-value">$@Model.ReturnFlight.Price.ToString("N0")</div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                
                <!-- Passenger Information -->
                <div class="detail-card">
                    <div class="card-header">
                        <div class="card-icon">
                            <i class="fas fa-users"></i>
                        </div>
                        <h2 class="card-title">Passenger Information</h2>
                    </div>
                    
                    <div class="passenger-list">
                        @for (int i = 0; i < Model.Passengers.Count; i++)
                        {
                            <div class="passenger-item">
                                <div class="passenger-number">@(i + 1)</div>
                                <div class="passenger-info">
                                    <div class="passenger-name">@Model.Passengers[i].FirstName @Model.Passengers[i].LastName</div>
                                    <div class="passenger-details">
                                        @Model.Passengers[i].PassengerType • 
                                        @Model.Passengers[i].DateOfBirth.ToString("MMM dd, yyyy") • 
                                        @Model.Passengers[i].Gender • 
                                        @Model.Passengers[i].Nationality
                                        @if (!string.IsNullOrEmpty(Model.Passengers[i].PassportNumber))
                                        {
                                            <span> • Passport: @Model.Passengers[i].PassportNumber</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                    
                    <div class="info-highlight">
                        <p>
                            <i class="fas fa-info-circle"></i>
                            @Model.Adults Adult@(Model.Adults != 1 ? "s" : "")@(Model.Children > 0 ? $", {Model.Children} Child{(Model.Children != 1 ? "ren" : "")}" : "")@(Model.Infants > 0 ? $", {Model.Infants} Infant{(Model.Infants != 1 ? "s" : "")}" : "")
                        </p>
                    </div>
                </div>
                
                <!-- Contact & Booking Information -->
                <div class="detail-card">
                    <div class="card-header">
                        <div class="card-icon">
                            <i class="fas fa-info-circle"></i>
                        </div>
                        <h2 class="card-title">Booking Information</h2>
                    </div>
                    
                    <div class="booking-info-vertical">
                        <div class="info-section">
                            <h4>Contact Details</h4>
                            <p><strong>Name:</strong> <span>@Model.UserName</span></p>
                            <p><strong>Email:</strong> <span>@Model.ContactEmail</span></p>
                            <p><strong>Phone:</strong> <span>@Model.ContactPhone</span></p>
                        </div>
                        
                        <div class="info-section">
                            <h4>Booking Details</h4>
                            <p><strong>Booking ID:</strong> <span>#@Model.BookingId</span></p>
                            <p><strong>Status:</strong> <span style="color: #10b981;">@Model.Status</span></p>
                            <p><strong>Booked on:</strong> <span>@Model.BookingDate.ToString("MMM dd, yyyy HH:mm")</span></p>
                        </div>
                    </div>
                    
                    <div class="email-confirmation">
                        <i class="fas fa-check-circle"></i>
                        <span>Confirmation email sent to @Model.ContactEmail</span>
                    </div>
                </div>
                
                <!-- Payment Summary -->
                <div class="detail-card">
                    <div class="card-header">
                        <div class="card-icon">
                            <i class="fas fa-credit-card"></i>
                        </div>
                        <h2 class="card-title">Payment Summary</h2>
                    </div>
                    
                    <div class="price-breakdown">
                        @if (Model.OutboundFlight != null)
                        {
                            <div class="price-item">
                                <span>
                                    Outbound Flight (@Model.OutboundFlight.FlightNumber)
                                    <br><span class="detail-info">Base price per seat</span>
                                </span>
                                <span>$@Model.OutboundFlight.Price.ToString("N0")</span>
                            </div>
                        }
                        
                        @if (Model.ReturnFlight != null)
                        {
                            <div class="price-item">
                                <span>
                                    Return Flight (@Model.ReturnFlight.FlightNumber)
                                    <br><span class="detail-info">Base price per seat</span>
                                </span>
                                <span>$@Model.ReturnFlight.Price.ToString("N0")</span>
                            </div>
                        }
                        
                        <div class="price-item">
                            <span>
                                Passengers Requiring Seats
                                <br><span class="detail-info">@(Model.Adults + Model.Children) passengers × flight prices</span>
                            </span>
                            <span>@(Model.Adults + Model.Children) seat@(Model.Adults + Model.Children != 1 ? "s" : "")</span>
                        </div>
                        
                        @if (Model.Infants > 0)
                        {
                            <div class="price-item">
                                <span>
                                    Lap Infants
                                    <br><span class="detail-info">@Model.Infants infant@(Model.Infants != 1 ? "s" : "") (no seat required)</span>
                                </span>
                                <span>No charge</span>
                            </div>
                        }
                        
                        @{
                            decimal flightSubtotal = 0;
                            var passengerCount = Model.Adults + Model.Children;
                            
                            if (Model.OutboundFlight != null)
                            {
                                flightSubtotal += Model.OutboundFlight.Price * passengerCount;
                            }
                            if (Model.ReturnFlight != null)
                            {
                                flightSubtotal += Model.ReturnFlight.Price * passengerCount;
                            }
                            
                            // Calculate taxes based on the difference between total and expected subtotal
                            var taxes = Model.TotalPrice - flightSubtotal;
                            
                            // If calculated taxes don't match expected 18%, use 18% rule as fallback
                            var expectedTaxes = flightSubtotal * 0.18m;
                            if (Math.Abs(taxes - expectedTaxes) > 1)
                            {
                                taxes = expectedTaxes;
                            }
                        }
                        
                        <div class="price-item subtotal">
                            <span>Flight Subtotal</span>
                            <span>$@flightSubtotal.ToString("N0")</span>
                        </div>
                        
                        <div class="price-item">
                            <span>Taxes & Fees (18%)</span>
                            <span>$@taxes.ToString("N0")</span>
                        </div>
                        
                        <div class="price-item total">
                            <span>
                                Total Amount
                                <br><span class="detail-info" style="font-weight: normal; font-size: 0.875rem;">Including all taxes and fees</span>
                            </span>
                            <span class="amount">$@Model.TotalPrice.ToString("N0")</span>
                        </div>
                    </div>
                    
                    <div class="payment-secure">
                        <p>
                            <i class="fas fa-shield-alt"></i>
                            Payment processed securely • All prices in USD
                        </p>
                    </div>
                </div>
            </div>
            
            <!-- Action Buttons -->
            <div class="action-buttons">
                <button class="btn btn-secondary" onclick="window.print()">
                    <i class="fas fa-print"></i>
                    Print Confirmation
                </button>
                <a href="@Url.Action("MyBookings", "Flight")" class="btn btn-primary btn-featured">
                    <i class="fas fa-list"></i>
                    View My Bookings
                </a>
                <a href="@Url.Action("Index", "Home")" class="btn btn-secondary">
                    <i class="fas fa-home"></i>
                    Back to Home
                </a>
            </div>
            
            <!-- Important Notice -->
            <div class="important-notice">
                <i class="fas fa-exclamation-triangle"></i>
                <p>
                    <strong>Important:</strong> Please save your booking reference number <strong>@Model.BookingReference</strong> for future reference. 
                    You'll need it for check-in and any changes to your booking. For private jet flights, we recommend arriving at the FBO at least 30 minutes before departure.
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Flight/booking-confirmation.js"></script>
}